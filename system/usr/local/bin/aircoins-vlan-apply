#!/bin/bash
# AirCoins network restore — applies saved config on boot.
#
# Phase 1: recreate every saved VLAN interface (identity only—no IP,
#          no DHCP; plain VLANs stay plain).
# Phase 1b: create bridges and enslave member interfaces (from vlans).
# Phase 2: provision every ENABLED portal server: portal IP, networkd
#          ownership file, dnsmasq DHCP + DNS hijack, captive rules.
#
# Source of truth are the flat files the API maintains (boot runs
# before the API/DB is up):
#   /etc/pisowifi/vlans.conf    interface vlan_id description
#   /etc/pisowifi/bridges.conf  bridge_name description member1 member2 ...
#   /etc/pisowifi/portals.conf  interface ip/cidr dhcp_start dhcp_end lease enabled|disabled
#
# A pre-split vlans.conf (ip/cidr inline in the 3rd field) is honored as
# a legacy fallback until the API rewrites the files on its first start.
VLAN_CONF="/etc/pisowifi/vlans.conf"
BRIDGES_CONF="/etc/pisowifi/bridges.conf"
PORTAL_CONF="/etc/pisowifi/portals.conf"

# Load 8021q kernel module
modprobe 8021q 2>/dev/null
sleep 1

# Set when a networkd file is created; triggers one reload at the end
reload_networkd=0

# Function: wait for interface to be UP
wait_for_iface() {
    local iface=$1
    local max_wait=30
    local waited=0
    while [ $waited -lt $max_wait ]; do
        if ip link show "$iface" 2>/dev/null | grep -q "state UP"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    logger -t aircoins-vlan "Timeout waiting for $iface to come up"
    return 1
}

# Function: wait for an interface to merely EXIST (portal targets are
# usually the VLANs created in phase 1, which can report DOWN with no
# carrier — existence is enough to assign the portal IP)
wait_for_iface_exists() {
    local iface=$1
    local max_wait=15
    local waited=0
    while [ $waited -lt $max_wait ]; do
        [ -d "/sys/class/net/$iface" ] && return 0
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

# ============================================
# PHASE 1: VLAN interfaces (identity only)
# ============================================
if [ -f "$VLAN_CONF" ]; then
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue

        # Parse: interface vlan_id ... (extra fields — new-format
        # description or legacy ip/cidr — are ignored here)
        parent=$(echo "$line" | awk '{print $1}')
        vid=$(echo "$line" | awk '{print $2}')

        if [ -z "$parent" ] || [ -z "$vid" ]; then
            continue
        fi

        name="${parent}.${vid}"

        # Wait for parent interface
        if ! wait_for_iface "$parent"; then
            logger -t aircoins-vlan "Skipping $name — parent $parent not ready"
            continue
        fi

        # Create VLAN interface if not exists
        if ! ip link show "$name" &>/dev/null; then
            ip link add link "$parent" name "$name" type vlan id "$vid" 2>/dev/null
            if [ $? -ne 0 ]; then
                logger -t aircoins-vlan "Failed to create $name"
                continue
            fi
            logger -t aircoins-vlan "Created VLAN $name"
        fi

        ip link set "$name" up 2>/dev/null
        logger -t aircoins-vlan "Restored VLAN $name"
    done < "$VLAN_CONF"
fi

# ============================================
# PHASE 1b: Bridges and bridge members
# ============================================
if [ -f "$BRIDGES_CONF" ]; then
    echo "=== Phase 1b: Bridges ==="
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue

        # Parse: bridge_name description member1 member2 ...
        read -ra parts <<< "$line"
        bridge_name="${parts[0]}"
        # parts[1] is description (skip for kernel operations)
        members=("${parts[@]:2}")

        # Create bridge if not exists
        if ! ip link show "$bridge_name" &>/dev/null; then
            echo "  Creating bridge $bridge_name"
            ip link add name "$bridge_name" type bridge
            ip link set "$bridge_name" up
            logger -t aircoins-vlan "Created bridge $bridge_name"
        fi

        # Add members and clean up stale networkd configs
        for member in "${members[@]}"; do
            if ip link show "$member" &>/dev/null; then
                current_master=$(ip -d link show "$member" 2>/dev/null | grep -oP 'master \K\S+')
                if [ -z "$current_master" ]; then
                    echo "  Adding $member to $bridge_name"
                    ip link set "$member" master "$bridge_name"
                    logger -t aircoins-vlan "Added $member to bridge $bridge_name"
                elif [ "$current_master" != "$bridge_name" ]; then
                    echo "  WARNING: $member already in bridge $current_master, skipping"
                    logger -t aircoins-vlan "WARNING: $member already in bridge $current_master"
                fi
            else
                echo "  WARNING: Member $member does not exist, skipping"
                logger -t aircoins-vlan "WARNING: bridge member $member does not exist"
            fi

            # Remove stale networkd config — bridge members are IP-less;
            # only the bridge itself gets a .network file (in Phase 2).
            netfile="/etc/systemd/network/04-aircoins-${member}.network"
            if [ -f "$netfile" ]; then
                echo "  Removing stale networkd config for bridge member $member"
                rm -f "$netfile"
                reload_networkd=1
                logger -t aircoins-vlan "Removed stale networkd config for bridge member $member"
            fi
        done
    done < "$BRIDGES_CONF"
fi

# ============================================
# PHASE 2: portal servers (hotspot stack)
# ============================================

# provision_portal <iface> <ip/cidr> <dhcp_start> <dhcp_end> <lease>
# dhcp_start/end may be empty for legacy entries — then the existing
# dnsmasq config written by the old system is reused as-is.
provision_portal() {
    local iface="$1" cidr="$2" start="$3" end="$4" lease="$5"
    local gw="${cidr%/*}"

    if ! wait_for_iface_exists "$iface"; then
        logger -t aircoins-vlan "Portal $iface skipped — interface not present"
        return 1
    fi

    ip link set "$iface" up 2>/dev/null
    sleep 1

    # Assign the portal IP (remove stale state first, then add fresh)
    ip addr flush dev "$iface" scope global 2>/dev/null
    ip addr add "$cidr" dev "$iface" 2>/dev/null

    # Verify IP was assigned
    if ! ip addr show "$iface" 2>/dev/null | grep -q "inet ${gw}"; then
        sleep 1
        ip addr add "$cidr" dev "$iface" 2>/dev/null
    fi

    # Ensure networkd owns the static IP (survives networkctl reload)
    NETFILE="/etc/systemd/network/04-aircoins-${iface}.network"
    if [ ! -f "$NETFILE" ]; then
        cat > "$NETFILE" << NETEOF
[Match]
Name=${iface}

[Network]
Address=${cidr}
DHCP=no
ConfigureWithoutCarrier=yes
NETEOF
        reload_networkd=1
        logger -t aircoins-vlan "Created networkd config for $iface"
    fi

    # dnsmasq DHCP + DNS hijack; regenerate the config if it went
    # missing and we know the range (same content as the API writes)
    DNSCONF="/etc/dnsmasq.d/${iface}.conf"
    if [ ! -f "$DNSCONF" ] && [ -n "$start" ] && [ -n "$end" ]; then
        cat > "$DNSCONF" << DNSEOF
# Auto-generated by AirCoins portal server for ${iface}
interface=${iface}
bind-dynamic
except-interface=lo
no-resolv
no-hosts
address=/#/${gw}
dhcp-range=${start},${end},${lease:-12h}
dhcp-option=3,${gw}
dhcp-option=6,${gw}
DNSEOF
        logger -t aircoins-vlan "Regenerated dnsmasq config for $iface"
    fi
    if [ -f "$DNSCONF" ]; then
        systemctl restart "dnsmasq@${iface}" 2>/dev/null
        if [ $? -ne 0 ]; then
            sleep 2
            systemctl restart "dnsmasq@${iface}" 2>/dev/null
        fi
        logger -t aircoins-vlan "Started DHCP for $iface"
    fi

    # Apply captive portal rules (DNS/HTTP capture + NAT for paid clients)
    if [ -x /usr/local/bin/aircoins-captive-rules ]; then
        /usr/local/bin/aircoins-captive-rules add "$iface" "$gw" >/dev/null 2>&1 ||
            logger -t aircoins-vlan "Failed to apply captive rules for $iface"
    fi

    logger -t aircoins-vlan "Restored portal $iface ($cidr)"
    return 0
}

# Count real (non-comment) portal entries. grep -cv prints 0 AND exits 1
# when nothing matches, so the count must be captured without a `|| echo`
# fallback — that would append a second line and break the -gt test.
portal_entries=0
if [ -f "$PORTAL_CONF" ]; then
    portal_entries=$(grep -cv -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$PORTAL_CONF" 2>/dev/null)
    portal_entries=${portal_entries:-0}
fi

if [ "$portal_entries" -gt 0 ]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue

        # Parse: interface ip/cidr dhcp_start dhcp_end lease enabled|disabled
        iface=$(echo "$line" | awk '{print $1}')
        cidr=$(echo "$line" | awk '{print $2}')
        start=$(echo "$line" | awk '{print $3}')
        end=$(echo "$line" | awk '{print $4}')
        lease=$(echo "$line" | awk '{print $5}')
        state=$(echo "$line" | awk '{print $6}')

        if [ -z "$iface" ] || [ -z "$cidr" ]; then
            continue
        fi
        if [ "$state" != "enabled" ]; then
            logger -t aircoins-vlan "Portal $iface is disabled — skipping"
            continue
        fi

        provision_portal "$iface" "$cidr" "$start" "$end" "$lease"
    done < "$PORTAL_CONF"
elif [ -f "$VLAN_CONF" ]; then
    # Legacy fallback: pre-split vlans.conf carried the portal config
    # inline (3rd field = ip/cidr). Restore those portals the old way so
    # a reboot right after the upgrade — before the API migrated the
    # flat files — changes nothing for paying clients.
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue

        parent=$(echo "$line" | awk '{print $1}')
        vid=$(echo "$line" | awk '{print $2}')
        cidr=$(echo "$line" | awk '{print $3}')

        if [ -z "$parent" ] || [ -z "$vid" ]; then
            continue
        fi
        case "$cidr" in
            */*) provision_portal "${parent}.${vid}" "$cidr" "" "" "" ;;
        esac
    done < "$VLAN_CONF"
fi

# Single reload if any networkd file was created above
if [ "$reload_networkd" -eq 1 ]; then
    networkctl reload 2>/dev/null
fi

logger -t aircoins-vlan "Network restore complete (VLANs + bridges + portal servers)"
